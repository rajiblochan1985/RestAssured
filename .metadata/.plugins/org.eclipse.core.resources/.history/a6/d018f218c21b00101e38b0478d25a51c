package CoreJavaPractice;

import java.util.HashSet;
import java.util.Set;

public class FindFirstRepeatedCharacterInaString {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		//Use Set since it does not allow duplicate values
		String str= "Automation";
		Set<Character> hset = new HashSet<Character>();
		for (int i=0; i<str.length(); i++)
		{
			if(!hset.add(str.charAt(i)))
			{
				System.out.println("First repeated character is: " +str.charAt(i));
				//break;
			}
		}	

	}

}
